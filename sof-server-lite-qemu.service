[Unit]
Description=Soldier of Fortune Linux server (QEMU i386)
Wants=network-online.target
Requires=sof-cpu-performance.service
After=network-online.target sof-cpu-performance.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sof-server-lite-nix
Environment=SOF_CPU=3
ExecStart=/home/pi/sof-server-lite-nix/start-qemu.sh
Restart=on-failure
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
